{
  "name": "nayeli",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nayeli-store",
      "database_id": "9bec11e9-76d7-4c87-a878-05f4084eb52a",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PRODUCT_FILES",
      "bucket_name": "nayeli-product-files",
    },
  ],
  "env": {
    "dev": {
      "name": "nayeli-dev",
      "vars": {
        "ACCESS_AUDIENCE": "6197ec530f8ef7988f80042cca3da9a95544739ef534464d8e8814354a2f8157",
        "ENVIRONMENT": "development",
        "WORKER_NAME": "nayeli-dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nayeli-store-dev",
          "database_id": "a7dc29a5-2081-4669-b3e0-6f2880ab28ec",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PRODUCT_FILES",
          "bucket_name": "nayeli-product-files-dev",
        },
      ],
    },
  },
}
